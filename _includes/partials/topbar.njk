<div class="topbar">
  <div class="container">
    <div class="topbar-contacts">
      <span><i class="fas fa-phone"></i> {{ settings.phone_display }}</span>
      <span><i class="fas fa-envelope"></i> {{ settings.email }}</span>
      <span><i class="fas fa-location-dot"></i> {{ settings.address }}</span>
    </div>
    <div class="topbar-social">
      <a href="{{ settings.facebook_url }}" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
      <a href="{{ settings.instagram_url }}" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
      <a href="{{ settings.tiktok_url }}" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
    </div>
  </div>
</div>

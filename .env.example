# --- Core ---
# Random long string used to sign admin session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Single admin account for the booking-management dashboard (the business owner).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Keep true on Railway (served over https). Set to false ONLY for local dev
# over plain http://localhost — real browsers silently drop a Secure cookie
# on non-https, which would otherwise make login look broken locally.
COOKIE_SECURE=true

# Comma-separated list of frontend origins allowed to submit bookings via fetch().
# Example: https://gpsusheringandevents.com,https://www.gpsusheringandevents.com
FRONTEND_ORIGINS=*

# --- Database ---
# Local dev defaults to SQLite. On Railway, add a Postgres plugin and it will
# inject DATABASE_URL automatically — no change needed here in production.
DATABASE_URL=sqlite:///./bookings.db

# --- GitHub OAuth proxy for the Decap CMS content admin (/admin on the site) ---
# Create a GitHub OAuth App at https://github.com/settings/developers with
# Authorization callback URL = https://<this-service's-public-url>/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

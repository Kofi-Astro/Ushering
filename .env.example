# --- Core ---
# Random long string used to sign admin session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Single admin account for the whole admin panel (bookings + content
# management) — the business owner logs in with this one account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Keep true on Railway (served over https). Set to false ONLY for local dev
# over plain http://localhost — real browsers silently drop a Secure cookie
# on non-https, which would otherwise make login look broken locally.
COOKIE_SECURE=true

# The admin panel is served on its own hostname (see app/main.py, which
# mounts it via Starlette's Host() matcher). admin.localhost resolves to
# 127.0.0.1 automatically in any modern browser/OS — no /etc/hosts editing
# needed for local dev. In production, set this to your real admin
# subdomain (and point its DNS at this same Railway service).
ADMIN_HOSTNAME=admin.localhost

# Comma-separated list of frontend origins allowed to submit bookings via fetch().
# Not needed for the default same-origin setup (the booking form posts to
# this same app) — only relevant if the public site is ever split onto a
# different domain than this backend.
FRONTEND_ORIGINS=*

# --- Database ---
# Local dev defaults to SQLite. On Railway, add a Postgres plugin and it will
# inject DATABASE_URL automatically — no change needed here in production.
DATABASE_URL=sqlite:///./bookings.db
